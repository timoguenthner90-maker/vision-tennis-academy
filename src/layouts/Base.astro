---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
}

const {
  title,
  description,
  ogImage = "/og.png",
  noindex = false,
  jsonLd = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageAbs = new URL(ogImage, Astro.site);
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#141414" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Vision Tennis Academy — Tennistraining an drei Vereinen zwischen Düsseldorf und Köln"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {
      blocks.map((b) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(b)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatWidget />

    <script>
      // Sticky-Header: verdichtet sich, sobald die Seite angescrollt ist.
      // Ein Sentinel-Element statt eines Scroll-Listeners — der Observer feuert
      // nur an der Schwelle und kostet nichts bei jedem Scroll-Frame.
      const sentinel = document.createElement("div");
      sentinel.setAttribute("aria-hidden", "true");
      sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px";
      document.body.prepend(sentinel);

      new IntersectionObserver(
        ([e]) =>
          document.documentElement.classList.toggle("is-stuck", !e.isIntersecting),
        { threshold: 0 },
      ).observe(sentinel);

      // Bilder beim Scrollen einblenden. Die Klasse am <html> schaltet den
      // Startzustand erst ein, wenn JavaScript läuft — ohne Skript bleibt jedes
      // Bild sichtbar. Bei reduzierter Bewegung passiert nichts.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = Array.from(
        document.querySelectorAll<HTMLElement>("[data-reveal]"),
      );

      if (!reduce && targets.length && "IntersectionObserver" in window) {
        document.documentElement.classList.add("js-reveal");

        // Bilder derselben Gruppe laufen versetzt an, damit ein Raster nicht
        // als Block aufploppt, sondern sich der Reihe nach setzt.
        const counters = new Map<Element, number>();
        for (const el of targets) {
          const group = el.closest("section") ?? document.body;
          const i = counters.get(group) ?? 0;
          counters.set(group, i + 1);
          el.style.setProperty("--reveal-delay", `${Math.min(i, 8) * 70}ms`);
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );

        for (const el of targets) io.observe(el);
      }
    </script>
  </body>
</html>

---
/**
 * Startseite nach dem Storytelling Skill Framework (12 Elemente, feste Reihenfolge).
 * Held = alle Zielgruppen der Academy gemeinsam (Kinder, Jugendliche, Erwachsene,
 * Mannschaft) — die Seite grenzt bewusst auf keine Persona ein. Persona-Unterseiten
 * (z. B. die Eltern/Kind-Seite unter src/pages/_eltern-kind.astro) sind vorbereitet,
 * aber aktuell bewusst nicht verlinkt — bei Bedarf Datei-Präfix „_" entfernen, damit
 * Astro die Route wieder baut. Die Marke tritt als Guide auf (#7).
 *
 *  1 Logo + 2 Navigation → Header.astro
 *  3 Heroshot · 4 Headline · 5 Einleitung · 9 CTA   → Hero
 *  6 Painpoints · 9 CTA
 *  7 Vorstellung (Autorität) · 9 CTA
 *  8 Plan (3 Schritte) · 9 CTA
 * 10 Trust
 * 11 Testimonials · 9 CTA
 * 12 Weitere Elemente + Footer
 */
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { clubs, coachCount, headCoaches, site } from "../data/site";
import { organizationLd, websiteLd } from "../data/jsonld";

const title = "Vision Tennis Academy — Tennistraining Dormagen & Köln";
const description =
  "Tennistraining für Kinder, Jugendliche und Erwachsene an drei Vereinen zwischen Düsseldorf und Köln. Gruppen von 1 bis 4, feste Zeiten, Schnupperstunde möglich.";

// Element #6 — die sechs Painpoints stammen unverändert aus der Empathy Map
// des Kunden (Pains + die offenen Fragen aus „Was sagt sie?").
const pains = [
  {
    t: "„Ist die Gruppe wirklich passend?“",
    d: "Zu stark, zu schwach, zu alt, zu jung: In der falschen Gruppe geht die Motivation schnell verloren.",
  },
  {
    t: "Trainingszeiten, die nicht in die Woche passen",
    d: "Zwischen Schule, Job und Geschwisterkindern bleibt nur ein schmales Zeitfenster. Passt der Slot nicht, fällt das Training aus.",
  },
  {
    t: "Ständig wechselnde Trainer",
    d: "Vertrauen entsteht über Monate. Wer alle paar Wochen einen neuen Coach vor sich hat, fängt jedes Mal von vorn an.",
  },
];

// Element #8 — der 3-Schritte-Plan
const steps = [
  {
    t: "Melde dich bei uns",
    d: "Eine kurze E-Mail: Alter, bisherige Erfahrung und der Wunschtermin. Mehr brauchen wir nicht.",
  },
  {
    t: "Schnupperstunde",
    d: "Eine ganze Trainingsstunde in einer passenden Gruppe an einem unserer drei Vereine, unverbindlich.",
  },
  {
    t: "Feste Zeit, fester Trainer",
    d: "Passt es, ordnen wir eine Gruppe nach Alter und Niveau zu. Ab dann: derselbe Termin und derselbe Coach über die ganze Saison.",
  },
];

// Element #10 — nur belegbare Fakten, keine erfundenen Siegel oder Auszeichnungen.
const facts = [
  { n: String(coachCount), l: "Trainer:innen im Team" },
  { n: "1–4", l: "Personen pro Gruppe" },
  { n: "3", l: "Vereine in der Region" },
  { n: "2022", l: "gegründet in Dormagen" },
  { n: "DTB", l: "lizenzierte Coaches" },
  { n: "60 Min.", l: "Schnupperstunde" },
];

const testimonials = [
  {
    q: "Unsere Tochter ist als blutige Anfängerin gestartet und geht jetzt jede Woche freiwillig hin. Die Gruppe passt einfach.",
    a: "Sabine Krüger, Mutter",
    club: "TC Dormagen",
  },
  {
    q: "Ich wollte nach zwanzig Jahren Pause wieder anfangen. Nach der Schnupperstunde war klar, dass das Niveau passt.",
    a: "Markus Weidner, Erwachsener Freizeitspieler",
    club: "TC Ford Köln",
  },
  {
    q: "Im Mannschaftstraining wird konkret an den Punkten gearbeitet, die im Match fehlen. Das merkt man in der Medenrunde.",
    a: "Julian Kessler, Mannschaftsspieler",
    club: "Uedesheimer TV",
  },
];
---

<Base title={title} description={description} jsonLd={[organizationLd, websiteLd]}>
  <!-- #3 Heroshot · #4 Headline · #5 Einleitung · #9 CTA
       Das Bild trägt die Sektion vollflächig, der Text liegt darüber. Ein
       Verlaufs-Scrim von links sichert den Kontrast, ohne das Motiv rechts
       zuzudecken. Motiv bewusst neutral gewählt (Aufschlag von hinten, kein
       erkennbares Alter oder Geschlecht im Vordergrund), damit der erste
       Eindruck keine Zielgruppe bevorzugt. Bewusst farbig (Stand 04.09.2026,
       bestätigt) - anders als die übrige, durchgehend graustufige
       Bildsprache der restlichen Seite. -->
  <section class="hero">
    <img
      class="hero__bg"
      src="/img/hero-court-serve.webp"
      alt="Ein Spieler beim Aufschlag auf dem Sandplatz vor der Bande der Vision Tennis Academy"
      width="1822"
      height="863"
      fetchpriority="high"
      decoding="async"
    />
    <div class="wrap hero__inner">
      <div class="hero__text">
        <span class="eyebrow">Dormagen · Köln · Neuss</span>
        <h1>Tennistraining für jedes Alter, jeden Anspruch.</h1>
        <p class="lead">
          Kinder, Jugendliche, Erwachsene und Mannschaften trainieren bei uns in
          passenden Gruppen nach Alter und Spielstärke, mit fester Zeit und festem
          Trainer, an drei Vereinen zwischen Düsseldorf und Köln.
        </p>
        <Cta />
      </div>
    </div>
  </section>

  <!-- #6 Painpoints · #9 CTA -->
  <section class="section section--muted">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Warum die Wahl so schwerfällt</span>
        <h2>Beim Tennistraining entscheidet sich vieles vor der ersten Stunde.</h2>
        <p class="lead">
          Nicht die Frage, ob trainiert wird, sondern in welcher Gruppe, zu welcher
          Zeit und bei wem. Genau daran scheitern die meisten Anmeldungen.
        </p>
      </div>

      <ul class="grid grid--3 pain-list">
        {
          pains.map((p) => (
            <li class="pain">
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))
        }
      </ul>

      <div class="cta-row"><Cta /></div>
    </div>
  </section>

  <!-- #7 Vorstellung / Autorität -->
  <section class="section">
    <div class="wrap guide">
      <div>
        <span class="eyebrow">Wer wir sind</span>
        <h2>Drei Trainer, die eine Tennisschule wollten, die verlässlich läuft.</h2>
        <p>
          Im Juni 2022 haben Jan, Max und Timo die Vision Tennis Academy gegründet. Alle
          drei sind DTB-B-Trainer und alle drei stehen selbst noch auf dem Platz. Aus
          drei Coaches sind inzwischen {coachCount} geworden, vom DTB-A-Trainer bis zu
          den Nachwuchscoaches in Ausbildung.
        </p>
        <p>
          Der Anspruch ist dabei derselbe geblieben: Training, das sich an der einzelnen
          Person orientiert, nicht an der Gruppengröße. Deshalb trainieren bei uns
          höchstens vier Personen gleichzeitig, und deshalb bleibt der Trainer über die
          Saison derselbe. Was wir ergänzt haben, ist die Organisation drumherum:
          Anmeldung, Gruppeneinteilung und Abrechnung laufen digital, damit vom Training
          mehr übrig bleibt als Verwaltung.
        </p>
        <ul class="ticks">
          <li>Ganzjährig trainieren: im Sommer draußen, im Winter in der Halle</li>
          <li>Kinder und Jugendliche ab 5 Jahren, Erwachsene bis 90</li>
          <li>Von der ersten Ballschule bis zum Mannschafts- und Turniertraining</li>
        </ul>
        <div class="cta-row cta-row--start"><Cta /></div>
      </div>

      <!-- Reihenfolge und Großbild werden beim Laden per Skript gewürfelt, damit
           bei jedem Aufruf ein anderer Gründer vorn steht. Ohne JavaScript bleibt
           es bei der Reihenfolge aus den Stammdaten. -->
      <div class="guide__pics">
        {
          headCoaches.map((c) => (
            <img
              data-reveal
              src={`/img/${c.img}.webp`}
              alt={`${c.name}, ${c.role} der Vision Tennis Academy`}
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- #8 Plan · #9 CTA -->
  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">So einfach geht es</span>
        <h2>In drei Schritten auf den Platz.</h2>
      </div>

      <ol class="grid grid--3 steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>

      <div class="cta-row cta-row--start">
        <Cta />
        <p class="cta-note">
          Lieber direkt selbst buchen? Die Termine der drei Vereine findest du unter
          <a href="/training/">Training</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- #10 Trust — belegbare Fakten statt Siegel -->
  <section class="section section--tight">
    <div class="wrap">
      <ul class="facts">
        {
          facts.map((f) => (
            <li class="fact">
              <span class="fact__n">{f.n}</span>
              <span class="fact__l">{f.l}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- #11 Testimonials · #9 CTA -->
  <section class="section section--muted">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Stimmen</span>
        <h2>Was Spielerinnen, Spieler und Eltern sagen.</h2>
      </div>

      <div class="grid grid--3">
        {
          testimonials.map((t) => (
            <figure class="quote">
              <blockquote>{t.q}</blockquote>
              <figcaption>
                {t.a}
                <br />
                {t.club}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="cta-row"><Cta /></div>
    </div>
  </section>

  <!-- #12 Weitere Elemente: Standorte + Kontaktfinale -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Wo wir trainieren</span>
        <h2>Drei Vereine, ein Trainerteam.</h2>
        <p class="lead">
          In Dormagen und Köln trainieren wir ganzjährig, im Winter in der Halle. In
          Uedesheim läuft die Sommersaison; über den Winter geht es in Dormagen weiter.
        </p>
      </div>

      <div class="grid grid--3">
        {
          clubs.map((c) => (
            <article class="card club-card">
              <div class="club-card__head">
                <img
                  src={`/img/${c.logo}.webp`}
                  alt={`Vereinswappen ${c.name}`}
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
                <h3>{c.name}</h3>
              </div>
              <p class="muted">
                {c.street} · {c.zip} {c.city}
              </p>
              <p>{c.courts}.</p>
              <a class="btn-ghost" href={`/standorte/#${c.slug}`}>
                Zur Anlage
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--dark" id="kontakt">
    <div class="wrap finale">
      <div>
        <span class="eyebrow">Der nächste Schritt</span>
        <h2>Eine Stunde ausprobieren, dann entscheiden.</h2>
        <p class="lead">
          Ob für dein Kind, für dich selbst oder fürs Mannschaftstraining: Schreib
          uns kurz, worum es geht und wann ihr Zeit habt. Wir suchen die passende
          Gruppe und melden uns zurück.
        </p>
        <Cta withNote />
      </div>
      <ul class="finale__contact">
        <li>
          <span>E-Mail</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>Adresse</span>
          {site.street}, {site.zip} {site.city}
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Der Hero füllt höchstens einen Bildschirm abzüglich Kopfleiste. Sonst rutscht
     der CTA unter die Falz. Nach unten begrenzt, damit er auf sehr flachen
     Fenstern nicht zusammengedrückt wird. */
  .hero {
    position: relative;
    isolation: isolate;
    background: #1a1a1a; /* neutraler Grauton als Fallback, falls das Bild noch lädt */
    color: #fff;
    min-height: clamp(28rem, calc(100svh - 7rem), 40rem);
    display: flex;
    align-items: center;
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
    overflow: hidden;
  }
  .hero > .wrap {
    width: min(100% - var(--gutter) * 2, var(--wrap));
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bild ist breiter als die meisten Ausschnitte — Ausschnitt Richtung Spieler
       verschoben, damit die Aktion rechts erhalten bleibt und links Platz für
       den Text frei wird. */
    object-position: 78% 38%;
    z-index: -2;
  }

  /* Scrim: links kräftig, rechts offen, damit das Motiv sichtbar bleibt.
     Neutral in Schwarz statt warmem Braun, passend zum Graustufenbild. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(8, 8, 8, 0.92) 0%, rgba(8, 8, 8, 0.8) 34%,
        rgba(8, 8, 8, 0.4) 62%, rgba(8, 8, 8, 0.1) 100%),
      linear-gradient(to top, rgba(8, 8, 8, 0.5) 0%, rgba(8, 8, 8, 0) 45%);
  }

  .hero__inner {
    display: grid;
  }

  .hero__text {
    max-width: 34rem;
  }

  .hero .eyebrow {
    color: var(--brand);
  }

  .hero h1 {
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }

  .hero .lead {
    color: #ece9e2;
  }

  /* Button und Hinweiszeile stehen in global.css — sie kommen aus Cta.astro
     und werden von diesem scoped Block nicht erreicht. */

  @media (max-width: 55rem) {
    .hero {
      padding-block: clamp(3rem, 9vw, 5rem);
    }
    .hero__bg {
      object-position: 82% 40%;
    }
    .hero::before {
      background:
        linear-gradient(180deg, rgba(8, 8, 8, 0.78) 0%, rgba(8, 8, 8, 0.68) 45%,
          rgba(8, 8, 8, 0.86) 100%);
    }
  }

  /* Schmale Geräte: Textstufen und Abstände zurücknehmen, damit der CTA
     zusammen mit Headline und Einleitung auf den ersten Bildschirm passt. */
  @media (max-width: 30rem) {
    .hero {
      min-height: 0;
      padding-block: 1.75rem 2rem;
    }
    .hero h1 {
      font-size: 1.85rem;
      margin-bottom: 0.85rem;
    }
    .hero .lead {
      font-size: 1rem;
      line-height: 1.45;
    }
    .hero .cta-row {
      margin-top: 1.5rem;
      gap: 0.75rem;
    }
    .hero .cta-note {
      font-size: 0.75rem;
    }
  }


  /* Das Framework zeichnet die Painpoints als 3×2-Raster. Ohne feste Spaltenzahl
     bricht auto-fit auf breiten Viewports in 4+2 um — unruhig und asymmetrisch. */
  .pain-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 62rem) {
    .pain-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guide {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .guide p {
    max-width: 60ch;
  }
  .guide__pics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .guide__pics img {
    border-radius: var(--radius);
    width: 100%;
  }
  /* Ohne JavaScript ist das erste Bild das große — feste, sinnvolle Vorgabe. */
  .guide__pics img:first-child {
    grid-column: span 2;
  }

  /* Sobald das Skript gewürfelt hat, entscheidet die Klasse statt der Position. */
  .guide__pics.is-rotated img:first-child {
    grid-column: auto;
  }
  .guide__pics.is-rotated img.is-lead {
    grid-column: span 2;
  }

  @media (max-width: 55rem) {
    .guide {
      grid-template-columns: 1fr;
    }
    .guide__pics {
      grid-template-columns: repeat(3, 1fr);
    }
    .guide__pics img:first-child,
    .guide__pics.is-rotated img.is-lead {
      grid-column: auto;
    }
  }

  .steps {
    list-style: none;
    counter-reset: none;
    margin: 0;
    padding: 0;
  }

  .finale {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .finale__contact {
    list-style: none;
    display: grid;
    gap: 1.4rem;
    border-top: 1px solid #333330;
    padding-top: 1.75rem;
  }
  .finale__contact li {
    display: grid;
    gap: 0.2rem;
    color: #d5d5d0;
  }
  .finale__contact span {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .finale__contact a {
    text-decoration: none;
    border-bottom: 1px solid #55554f;
    justify-self: start;
  }
  .finale__contact a:hover {
    border-bottom-color: var(--brand);
  }

  @media (max-width: 55rem) {
    .finale {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Gründer-Porträts bei jedem Aufruf neu anordnen: Wer groß erscheint und in
  // welcher Reihenfolge die drei stehen, wird zufällig bestimmt.
  //
  // Die Seite ist statisch ausgeliefert, es gibt also keinen Server, der pro
  // Abruf variieren könnte — deshalb im Browser. Ohne JavaScript bleibt es bei
  // der Reihenfolge aus den Stammdaten, das erste Bild ist dann das große.
  // Umgestellt wird vor dem Einblenden, es gibt also kein sichtbares Springen.
  const pics = document.querySelector<HTMLElement>(".guide__pics");

  if (pics) {
    const imgs = Array.from(pics.querySelectorAll<HTMLImageElement>("img"));

    if (imgs.length > 1) {
      // Fisher-Yates: jede Reihenfolge gleich wahrscheinlich.
      const order = imgs.map((_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }

      imgs.forEach((img, i) => {
        const pos = order.indexOf(i);
        img.style.order = String(pos);
        img.classList.toggle("is-lead", pos === 0);
      });

      pics.classList.add("is-rotated");
    }
  }
</script>

---
/**
 * Schnupperstunden-Anfrage — der Buchungskalender der Seite.
 *
 * Bewusst ohne Backend: Vision bucht keine Einzeltermine, sondern feste
 * Wochenslots über eine ganze Saison; die verbindliche Buchung samt Abrechnung
 * läuft weiterhin über Sportision. Was hier fehlte, war der Schritt davor —
 * die Schnupperstunde. Genau dort springen Interessenten laut Journey ab.
 *
 * Schnupperstunden finden ausschließlich samstags statt. Die Uhrzeit können
 * Interessierte sich nicht aussuchen — die stimmen wir nach der Anfrage
 * direkt mit ihnen ab. Formular sammelt nur Verein, Alter und Spielstärke;
 * daraus entsteht eine fertige E-Mail.
 *
 * Bewusst kein WhatsApp-Link: Kommunikation läuft hauptsächlich über E-Mail,
 * der noch kommende Chatbot übernimmt künftig erste Fragen.
 *
 * Datenschutz: Es verlässt nichts den Browser. Erst der Klick auf „Anfrage
 * senden" öffnet das Mailprogramm des Nutzers mit dem vorbereiteten Text.
 * Keine Übertragung an uns, kein Server, keine Cookies.
 */
import Base from "../layouts/Base.astro";
import { clubs, site } from "../data/site";

const title = "Schnupperstunde anfragen — Vision Tennis Academy";
const description =
  "Verein, Alter und Spielstärke für deine Schnupperstunde am Samstag auswählen. Wir suchen die passende Gruppe, stimmen die Uhrzeit ab und melden uns zurück.";

const ages = [
  "Kind, 5–12 Jahre",
  "Jugendliche:r, 13–17 Jahre",
  "Junger Erwachsene:r, 18–25 Jahre",
  "Erwachsene:r, ab 25 Jahren",
];

const levels = [
  "Anfänger:in, noch nie gespielt",
  "Grundlagen vorhanden",
  "Spielt regelmäßig",
  "Mannschaft oder Turnier",
];
---

<Base title={title} description={description}>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow">Schnupperstunde</span>
      <h1>Sag uns, wo du starten willst.</h1>
      <p class="lead">
        Eine ganze Trainingsstunde zum Ausprobieren, ohne Mitgliedschaft.
        Schnupperstunden finden samstags statt. Wähl deinen Verein, wir suchen
        die passende Gruppe, stimmen eine Uhrzeit mit dir ab und melden uns
        zurück.
      </p>
    </div>
  </section>

  <section class="section section--tight booking">
    <div class="wrap">
      <div id="pf">
        <!-- Schritt 1 -->
        <fieldset class="step-block">
          <legend><span class="step-n">1</span> An welchem Verein?</legend>
          <div class="choices choices--club">
            {
              clubs.map((c, i) => (
                <label class="choice">
                  <input type="radio" name="club" value={c.name} checked={i === 0} />
                  <span class="choice__body choice__body--club">
                    <span>
                      <span class="choice__t">{c.name}</span>
                      <span class="choice__s">
                        {c.zip} {c.city}
                      </span>
                    </span>
                    <img
                      src={`/img/${c.logo}.webp`}
                      alt=""
                      aria-hidden="true"
                      width="320"
                      height="320"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Schritt 2 -->
        <fieldset class="step-block">
          <legend><span class="step-n">2</span> Wer möchte trainieren?</legend>
          <div class="two-col">
            <div>
              <p class="sub-label" id="lbl-age">Alter</p>
              <div class="choices" role="group" aria-labelledby="lbl-age">
                {
                  ages.map((a, i) => (
                    <label class="choice choice--sm">
                      <input type="radio" name="age" value={a} checked={i === 0} />
                      <span class="choice__body">
                        <span class="choice__t">{a}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div>
              <p class="sub-label" id="lbl-level">Spielstärke</p>
              <div class="choices" role="group" aria-labelledby="lbl-level">
                {
                  levels.map((l, i) => (
                    <label class="choice choice--sm">
                      <input type="radio" name="level" value={l} checked={i === 0} />
                      <span class="choice__body">
                        <span class="choice__t">{l}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>
        </fieldset>

        <!-- Schritt 3 — Uhrzeit am Schnuppertag Samstag -->
        <fieldset class="step-block">
          <legend><span class="step-n">3</span> Uhrzeit am Samstag</legend>
          <p class="hint">
            Die Schnupperstunde findet immer samstags statt. Nach deiner Anfrage
            melden wir uns mit einer passenden Uhrzeit bei dir.
          </p>

          <p class="sub-label" style="margin-top:1.5rem">Optional</p>
          <div class="two-col">
            <label class="field">
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" placeholder="z. B. Familie Meyer" />
            </label>
            <label class="field">
              <span>Noch etwas, das wir wissen sollten?</span>
              <input type="text" name="note" placeholder="z. B. Geschwisterkind spielt schon" />
            </label>
          </div>
        </fieldset>

        <!-- Ergebnis -->
        <div class="result" id="result">
          <div>
            <p class="sub-label">Das schicken wir los</p>
            <pre id="preview" aria-live="polite"></pre>
          </div>
          <div class="send">
            <a class="btn" id="mail" href={`mailto:${site.email}`} rel="noopener">
              Anfrage per E-Mail senden
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <p class="privacy">
              Deine Angaben bleiben bis zum Klick in deinem Browser. Erst dann
              öffnet sich dein Mailprogramm mit dem vorbereiteten Text. Wir
              empfangen vorher nichts.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Was danach passiert</span>
        <h2>Drei Schritte, dann steht ihr auf dem Platz.</h2>
      </div>
      <div class="grid grid--3">
        <div>
          <h3>Wir melden uns</h3>
          <p>Meist noch am selben Tag. Während des Trainings kann es etwas länger dauern.</p>
        </div>
        <div>
          <h3>Termin steht</h3>
          <p>Wir legen die Schnupperstunde in eine Gruppe, die zu Alter und Niveau passt.</p>
        </div>
        <div>
          <h3>Ausprobieren</h3>
          <p>60 Minuten, ohne Mitgliedschaft. Schläger stellen wir, falls nötig.</p>
        </div>
      </div>
      <p class="muted" style="margin-top:2rem">
        Lieber direkt selbst buchen? Die regulären Termine der Vereine findest du
        unter <a href="/training/">Training</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .booking form {
    max-width: 58rem;
  }

  fieldset.step-block {
    border: 0;
    padding: 0;
    margin: 0 0 clamp(2.25rem, 5vw, 3.5rem);
  }

  legend {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--step-2);
    font-weight: 800;
    padding: 0;
    margin-bottom: 1.25rem;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    background: var(--brand);
    border: 2px solid var(--ink);
    border-radius: 50%;
    font-size: 0.95rem;
  }

  .hint {
    color: var(--ink-2);
    max-width: 58ch;
    margin-bottom: 1.25rem;
  }

  .sub-label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem 2rem;
  }

  /* ---- Auswahlkacheln ---- */

  .choices {
    display: grid;
    gap: 0.6rem;
  }
  .choices--club {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .choice {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .choice input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .choice__body {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    padding: 0.85rem 1rem;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .choice--sm .choice__body {
    padding: 0.6rem 0.85rem;
  }
  /* Vereinsauswahl: Name und Ort links, Wappen rechts als Ankerpunkt. Das
     Wappen ist rein dekorativ (alt=""), der Vereinsname steht daneben im Text.
     Die weiße Platte darunter ist Absicht — sie hält die Wappen auch auf der
     gelben Auswahlfläche lesbar. */
  .choice__body--club {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .choice__body--club img {
    width: clamp(3.4rem, 6vw, 4.2rem);
    height: clamp(3.4rem, 6vw, 4.2rem);
    flex: none;
    object-fit: contain;
    border-radius: 4px;
    background: #fff;
    padding: 0.3rem;
    box-shadow: 0 0 0 1px rgba(20, 20, 20, 0.12);
  }
  .choice__t {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .choice__s {
    display: block;
    font-size: var(--step--1);
    /* --ink-3 reicht auf der gelben Auswahlflaeche nicht fuer 4.5:1. */
    color: var(--ink-2);
    margin-top: 0.15rem;
  }
  .choice:hover .choice__body {
    border-color: var(--ink);
  }
  .choice input:checked + .choice__body {
    border-color: var(--brand-deep);
    background: var(--brand);
  }
  .choice input:focus-visible + .choice__body {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field span {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .field input {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .field input:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    border-color: var(--ink);
  }

  /* ---- Ergebnis ---- */

  .result {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    border-top: 3px solid var(--ink);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }
  #preview {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin: 0;
    color: var(--ink-2);
  }
  .send {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .privacy {
    font-size: var(--step--1);
    color: var(--ink-3);
    margin: 0;
  }

  @media (max-width: 48rem) {
    .result {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Uhrzeit-Picker für den Schnuppertag Samstag. Kein Netzwerkverkehr: Die
  // Auswahl wird ausschließlich im Browser zu einem Nachrichtentext
  // zusammengesetzt und in den href-Wert des Sende-Links geschrieben.
  const form = document.getElementById("pf");
  const preview = document.getElementById("preview");
  const mail = document.getElementById("mail") as HTMLAnchorElement | null;

  if (form && preview && mail) {
    const MAIL_TO = "info@vision-tennis.de";

    function value(name: string): string {
      const checked = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      if (checked) return checked.value;
      const text = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:not([type="radio"]):not([type="checkbox"])`,
      );
      return text?.value ?? "";
    }

    function buildMessage(): string {
      const lines = [
        "Hallo Vision Tennis Academy,",
        "",
        "ich möchte gern eine Schnupperstunde vereinbaren.",
        "",
        `Verein: ${value("club")}`,
        `Alter: ${value("age")}`,
        `Spielstärke: ${value("level")}`,
      ];

      lines.push("Uhrzeit am Samstag: stimmen wir gemeinsam ab.");

      const note = value("note").trim();
      if (note) lines.push(`Hinweis: ${note}`);

      const name = value("name").trim();
      lines.push("", "Viele Grüße" + (name ? `\n${name}` : ""));

      return lines.join("\n");
    }

    function update() {
      const msg = buildMessage();
      preview!.textContent = msg;
      mail!.href =
        `mailto:${MAIL_TO}` +
        `?subject=${encodeURIComponent("Anfrage Schnupperstunde")}` +
        `&body=${encodeURIComponent(msg)}`;
    }

    form.addEventListener("input", update);
    update();
  }
</script>

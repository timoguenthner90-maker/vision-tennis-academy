---
/**
 * Consideration → Purchase. Diese Seite trägt die Last der Entscheidungsphase:
 * Sie beantwortet die Fragen, die auf der Bestandsseite nur per Mail zu klären
 * waren — welche Gruppen, welches Alter, welche Zeiten, welcher Preis.
 */
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { clubs, winterSeason, winterTraining } from "../data/site";

const title = "Training & Preise — Vision Tennis Academy";
const description = `Gruppentraining von 1 bis 4 Personen für Kinder ab 5 und Erwachsene. Stundenpreise für ${winterSeason.label} nach Gruppengröße.`;

const offers = [
  {
    tag: "Kinder & Jugendliche",
    t: "Von der Ballschule bis zum Turniertraining",
    d: "Ab etwa 5 Jahren. Die Zuordnung erfolgt nach Alter und Niveau, nicht nach Jahrgang. Anfänger trainieren mit Anfängern, Ambitionierte mit Ambitionierten.",
    points: ["Gruppen von 1 bis 4", "60 Minuten pro Woche", "Feste Zeit über die Saison"],
  },
  {
    tag: "Erwachsene",
    t: "Wiedereinstieg oder regelmäßiges Spiel",
    d: "Von 18 bis 90 Jahren. Ob nach Jahren Pause oder als regelmäßig spielender Freizeitspieler, wir setzen dort an, wo du stehst.",
    points: ["Einzeln, zu zweit oder in der Gruppe", "Auch tagsüber möglich", "Ganzjährig, im Winter in der Halle"],
  },
  {
    tag: "Mannschaften",
    t: "Medenrunde und Turnierspiel",
    d: "Mannschaftstraining für 5 bis 8 Personen auf zwei Plätzen. Das gibt's nur im Sommer, weil im Winter die Hallenkapazität dafür fehlt.",
    points: ["5 bis 8 Personen", "Nur in der Sommersaison", "Zwei Plätze parallel"],
  },
];
---

<Base title={title} description={description}>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow">Training</span>
      <h1>Ein Trainingsplatz, der zu Alter, Niveau und Woche passt.</h1>
      <p class="lead">
        Wir trainieren an drei Vereinen zwischen Düsseldorf und Köln, in Gruppen von
        höchstens vier Personen, wöchentlich zur festen Zeit und mit demselben Trainer
        über die ganze Saison.
      </p>
      <div class="cta-row"><Cta withNote /></div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap">
      <div class="offer-head">
        <div class="section-head">
          <span class="eyebrow">Angebote</span>
          <h2>Für wen wir trainieren.</h2>
          <p class="lead">
            Drei Formate, ein Konzept: kleine Gruppen, feste Zeiten, lizenzierte
            Trainer:innen.
          </p>
        </div>
        <img
          data-reveal
          class="offer-pic"
          src="/img/training-schwung.webp"
          alt="Spieler beim Ausholen zur Rückhand"
          width="1000"
          height="750"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="grid grid--3">
        {
          offers.map((o) => (
            <article class="card">
              <span class="card__tag">{o.tag}</span>
              <h3>{o.t}</h3>
              <p>{o.d}</p>
              <ul class="ticks">
                {o.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Selbst buchen</span>
        <h2>Direkt beim Verein anmelden.</h2>
        <p class="lead">
          Wenn du lieber ohne Umweg buchst: Jeder unserer drei Vereine hat einen eigenen
          Zugang im Buchungssystem. Für die Schnupperstunde meldest du dich am
          besten trotzdem kurz bei uns, dann finden wir vorher die passende Gruppe.
        </p>
      </div>
      <div class="grid grid--3">
        {
          clubs.map((c) => (
            <article class="card club-card">
              <div class="club-card__head">
                <img
                  src={`/img/${c.logo}.webp`}
                  alt={`Vereinswappen ${c.name}`}
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
                <h3>{c.name}</h3>
              </div>
              <p class="muted">{c.season}</p>
              <a class="btn-ghost" href={c.booking} rel="noopener">
                Termine ansehen
              </a>
            </article>
          ))
        }
      </div>
      <div class="cta-row cta-row--start"><Cta withNote /></div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Preise · {winterSeason.label}</span>
        <h2>Schon vor der ersten Stunde weißt du, was es kostet.</h2>
        <p class="lead">
          Die Wintersaison läuft vom {winterSeason.from} bis zum {winterSeason.to}. Der
          Preis setzt sich aus zwei Teilen zusammen: dem Trainingsanteil und dem
          Hallenanteil.
        </p>
      </div>

      <div class="price-block">
        <div class="table-scroll">
          <table>
            <caption class="sr-only">Trainingsanteil pro Stunde nach Gruppengröße</caption>
            <thead>
              <tr>
                <th scope="col">Gruppe</th>
                <th scope="col">Pro Stunde (60 Min.)</th>
              </tr>
            </thead>
            <tbody>
              {
                winterTraining.map((t) => (
                  <tr>
                    <td>{t.group}</td>
                    <td>{t.perHour} €</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <dl class="price-parts">
          <div>
            <dt><span class="card__tag">Trainingsanteil</span></dt>
            <dd>
              Überall gleich, richtet sich nur nach der Gruppengröße. Für Jugendliche
              in der Vierergruppe etwas günstiger.
            </dd>
          </div>
          <div>
            <dt><span class="card__tag">Hallenanteil</span></dt>
            <dd>
              Hängt von Verein und Uhrzeit ab. Den genauen Preis nennen wir dir bei
              der Anmeldung.
            </dd>
          </div>
        </dl>
      </div>

      <div class="notes grid grid--2">
        <div class="pain">
          <h3>Wie abgerechnet wird</h3>
          <p>
            Nach dem Saisonstart erhältst du eine Rechnung über den Trainingsanteil. Der
            Betrag wird per SEPA-Lastschrift eingezogen, es gibt keine Vorkasse. Die
            Hallenkosten zieht der Verein separat und anteilig ein. Eine Kündigung ist
            nicht nötig: Das Training endet automatisch mit der Saison.
          </p>
        </div>
        <div class="pain">
          <h3>Mannschaftstraining</h3>
          <p>
            Für 5 bis 8 Personen bieten wir das nur in der Sommersaison an, im Winter
            reicht die Hallenkapazität dafür nicht. Sprich uns an, wenn du für den
            Sommer planst.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Ablauf</span>
        <h2>Wie eine Saison läuft.</h2>
      </div>
      <div class="grid grid--4">
        <div>
          <h3>Einstieg jederzeit</h3>
          <p>Du kannst das ganze Jahr über anfangen. Wir suchen dann eine Gruppe, die passt.</p>
        </div>
        <div>
          <h3>60 Minuten, wöchentlich</h3>
          <p>Eine feste Stunde pro Woche. Die konkrete Zeit erhältst du nach der Anmeldephase per E-Mail.</p>
        </div>
        <div>
          <h3>Ferien im Winter</h3>
          <p>Jugendstunden in Dormagen pausieren in den Ferien. Erwachsenenstunden laufen durch, außer in den Weihnachtsferien.</p>
        </div>
        <div>
          <h3>Drinnen statt draußen</h3>
          <p>Die Wintersaison läuft komplett in der Halle. Wetter spielt damit keine Rolle mehr.</p>
        </div>
      </div>
      <p class="muted season-note">
        Die Wintersaison läuft vom {winterSeason.from} bis zum {winterSeason.to}. Danach
        geht es zurück auf die Außenplätze. Uedesheim spielt bis dahin in Dormagen mit.
      </p>
      <div class="cta-row"><Cta /></div>
    </div>
  </section>
</Base>

<style>
  /* Angebotskarten: Die Häkchenliste soll in allen drei Karten auf derselben
     Höhe beginnen, unabhängig davon, wie lang der Beschreibungstext darüber
     ist. Betrifft gezielt nur Karten mit .ticks, nicht die übrigen Karten
     dieser Seite (z. B. "Wie abgerechnet wird" ohne Häkchenliste). */
  .card:has(.ticks) {
    display: flex;
    flex-direction: column;
  }
  .card:has(.ticks) p {
    flex: 1;
  }

  /* Vereinskarten unter "Selbst buchen": "Termine ansehen" soll überall auf
     gleicher Höhe stehen, auch wenn der Saison-Text unterschiedlich lang ist
     (Uedesheim braucht zwei Zeilen, die anderen beiden nur eine). */
  .club-card {
    display: flex;
    flex-direction: column;
  }
  .club-card p.muted {
    flex: 1;
  }

  /* Die Preise-Sektion liegt jetzt auf grauem Grund (section--muted) — ohne
     eigenen weißen Hintergrund würde die Tabelle optisch mit der Fläche
     verschmelzen (th nutzt dieselbe --paper-2-Farbe wie der Sektionsgrund).
     Nur zwei schmale Spalten mit kurzem Inhalt, deshalb bewusst kompakt statt
     über die volle Breite gezogen. */
  .table-scroll {
    background: var(--paper);
    max-width: 26rem;
    border-top: 4px solid var(--brand);
  }
  .table-scroll table {
    font-size: var(--step--1);
  }
  .table-scroll th,
  .table-scroll td {
    padding: 0.65rem 0.85rem;
  }
  .table-scroll th:last-child,
  .table-scroll td:last-child {
    text-align: center;
  }

  .offer-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .offer-head .section-head {
    margin-bottom: 0;
  }
  .offer-pic {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (max-width: 55rem) {
    .offer-head {
      grid-template-columns: 1fr;
    }
  }

  .notes {
    margin-top: 2.5rem;
  }
  .notes p {
    max-width: 42ch;
  }

  /* Tabelle und Zwei-Teile-Erklärung als ein Block: Die Erklärung füllt den
     Platz neben der schmalen Tabelle, statt darunter mit viel Leerraum zu
     stehen. */
  .price-block {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .price-block .table-scroll {
    max-width: none;
  }
  @media (max-width: 45rem) {
    .price-block {
      grid-template-columns: 1fr;
    }
  }

  .price-parts {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    align-content: start;
  }
  .price-parts > div {
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .price-parts > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .price-parts dt {
    font-weight: 800;
    margin-bottom: 0.3rem;
  }
  .price-parts dd {
    margin: 0;
    color: var(--ink-2);
    max-width: 42ch;
  }

  .season-note {
    margin-top: 2rem;
    margin-bottom: 0;
    color: #a6a6a1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

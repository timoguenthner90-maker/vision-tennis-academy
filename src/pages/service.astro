---
/**
 * Ersetzt den Shop. Bewusste Entscheidung des Kunden: kein Warenkorb, keine
 * Produktseiten, keine Onlinebestellung. Material gibt es weiterhin — die
 * Academy ist HEAD-Partner und bezieht Ausrüstung über die Marke, bestellt aber
 * erst auf Anfrage und übergibt im Training. Der Weg bleibt also das Gespräch
 * mit dem Trainer, nicht der Klick.
 */
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { site } from "../data/site";

const title = "Service rund um dein Material — Vision Tennis Academy";
const description =
  "Besaitung, Testschläger und Beratung bei deinem Trainer. Als HEAD-Partner bestellen wir deinen Wunschschläger und bringen ihn zur Trainingsstunde mit.";

const services = [
  {
    tag: "Besaitung",
    t: "Neue Saiten für 25 €",
    d: "Gib deinen Schläger beim Training ab. Für Premium-Saiten kommt je nach Material ein Aufpreis dazu — den nennen wir dir vorher.",
    points: ["Abgabe direkt beim Training", "25 € pro Besaitung", "Aufpreis nur bei Premium-Saiten"],
    img: "service-schlaeger",
    alt: "Tennisschläger und Schuhe auf einem Hartplatz",
  },
  {
    tag: "Testschläger",
    t: "Erst spielen, dann entscheiden",
    d: "Du kannst bei uns jederzeit Testschläger ausleihen. Welcher Schläger passt, merkst du in einer Trainingsstunde deutlich schneller als in jeder Produktbeschreibung.",
    points: ["Ausleihe jederzeit möglich", "Auch schon zur Probestunde", "Mehrere Modelle vergleichen"],
    img: "service-equipment",
    alt: "Schläger, Tasche und Schuhe vor einem Tennisnetz",
  },
  {
    tag: "Beratung",
    t: "Was zu deinem Spiel passt",
    d: "Griffstärke, Schlägergewicht, Saitenhärte, Bälle für Kinder — sprich deinen Trainer an. Er sieht dich spielen und kann konkret einordnen, was sinnvoll ist.",
    points: ["Beratung durch deinen Coach", "Auf Basis deines Spiels", "Ohne Verkaufsdruck"],
    img: "service-tasche",
    alt: "Spieler mit Schlägertasche am Spielfeldrand",
  },
];
---

<Base title={title} description={description}>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow">Service</span>
      <h1>Material-Service — dort, wo du ohnehin schon bist.</h1>
      <p class="lead">
        Besaitung, Testschläger, Beratung und Bestellung laufen bei uns direkt über das
        Training. Als Partner von <strong>HEAD</strong> beziehen wir Ausrüstung über die
        Marke — du fragst uns nach dem Preis, wir bestellen und bringen es zur nächsten
        Stunde mit.
      </p>
      <div class="cta-row"><Cta withNote /></div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Was wir anbieten</span>
        <h2>Alles rund um dein Material.</h2>
      </div>
      <div class="grid grid--3">
        {
          services.map((s) => (
            <article class="card card--pic">
              <img
                data-reveal
                src={`/img/${s.img}.webp`}
                alt={s.alt}
                width="1000"
                height="700"
                loading="lazy"
                decoding="async"
              />
              <span class="card__tag">{s.tag}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <ul class="ticks">
                {s.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">HEAD-Partner</span>
        <h2>Deinen Wunschschläger bestellst du über uns.</h2>
        <p class="lead">
          Die Vision Tennis Academy ist Partner der Sportmarke HEAD und bezieht ihr
          Equipment über die Marke. Einen Onlineshop gibt es dafür bewusst nicht — du
          fragst uns direkt nach dem Preis, alles Weitere übernehmen wir.
        </p>
      </div>

      <img
        data-reveal
        class="head-band"
        src="/img/service-head.webp"
        alt="Tennistaschen, Schläger und Schuhe von HEAD auf einem Platz"
        width="1600"
        height="640"
        loading="lazy"
        decoding="async"
      />

      <ol class="grid grid--3 steps">
        <li class="step">
          <span class="step__num" aria-hidden="true">1</span>
          <h3>Preis anfragen</h3>
          <p>
            Sag deinem Coach, welcher Schläger dich interessiert, oder schreib uns eine
            Nachricht. Du bekommst den Preis von uns genannt.
          </p>
        </li>
        <li class="step">
          <span class="step__num" aria-hidden="true">2</span>
          <h3>Wir bestellen</h3>
          <p>
            Passt der Preis, bestellen wir das gewünschte Produkt über HEAD. Du musst dich
            um nichts weiter kümmern.
          </p>
        </li>
        <li class="step">
          <span class="step__num" aria-hidden="true">3</span>
          <h3>Übergabe im Training</h3>
          <p>
            Wir bringen es zu deiner nächsten Trainingsstunde mit — kein Versand, keine
            Wartezeit zu Hause, keine Rücksendung.
          </p>
        </li>
      </ol>

      <div class="two shop-note">
        <div>
          <h3>Erst spielen, dann bestellen.</h3>
        </div>
        <div>
          <p>
            Bei Schlägern, Saiten und Griffen entscheidet das persönliche Gefühl mehr als
            jede Spezifikation. Wer einen Schläger einmal eine Stunde lang gespielt hat,
            weiß mehr als nach dem Vergleich von zehn Produktseiten.
          </p>
          <p>
            Deshalb leihen wir dir vorher einen Testschläger, sehen dich damit spielen und
            sagen dir ehrlich, was passt — auch wenn am Ende ein anderes Modell dabei
            herauskommt als das, nach dem du gefragt hast.
          </p>
          <a class="btn-ghost" href={`mailto:${site.email}`}>
            Preis für einen Schläger anfragen
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Noch kein Training bei uns?</span>
        <h2>Bring einfach deinen Schläger zur Probestunde mit.</h2>
        <p class="lead">
          Die erste Stunde ist kostenlos. Wenn du noch keinen eigenen Schläger hast,
          stellen wir für die Probestunde einen zur Verfügung.
        </p>
      </div>
      <Cta withNote />
    </div>
  </section>
</Base>

<style>
  /* Bild sitzt bündig in der Karte, Text bekommt den Innenabstand zurück. */
  .card--pic {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card--pic img {
    width: 100%;
    aspect-ratio: 10 / 7;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .card--pic > :not(img) {
    margin-inline: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .card--pic > .card__tag {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .card--pic > :last-child {
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* Flaches Band über den Bestellschritten — nicht höher werden lassen, sonst
     drückt es die Schritte unter die Falz. */
  .head-band {
    width: 100%;
    aspect-ratio: 5 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Nummerierung kommt aus .step__num, nicht aus dem Listenmarker. */
  .steps {
    list-style: none;
  }

  /* Setzt die Testschläger-Logik unter die drei Bestellschritte ab. */
  .shop-note {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .two p {
    max-width: 60ch;
  }
  @media (max-width: 55rem) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>

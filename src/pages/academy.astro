---
/**
 * Consideration + Loyalty. Trägt Purpose, Werte und die drei Head Coaches —
 * laut Empathy Map ist „guter Trainer, gleicher Trainer" der stärkste Gain, also
 * bekommen sie Gesicht und Lizenzstufe statt einer bloßen Zahl.
 *
 * Die Übersicht des ganzen Trainerteams (vormals Abschnitt „Das Team") ist
 * vorübergehend raus: Ein Teil der Coaches hatte nur Initialen statt echter
 * Fotos, das wirkte uneinheitlich. Kommt zurück, sobald neue Fotos da sind —
 * die Rosterdaten (`coaches` in data/site.ts) bleiben dafür unverändert.
 *
 * Der Ausblick auf Padel und Pickleball steht bewusst unter „Wohin wir wollen"
 * und nicht im Angebot — eine langfristige Idee ohne konkreten Zeitplan, kein
 * aktives Vorhaben.
 */
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { headCoaches, coachCount } from "../data/site";

const title = "Die Academy — Vision Tennis Academy";
const description =
  "Gegründet 2022 in Dormagen: 21 lizenzierte Trainerinnen und Trainer, drei Vereine, ein Konzept. Werte, Team und Ausblick der Vision Tennis Academy.";

const values = [
  { t: "Qualität", d: "Lizenzierte Trainer:innen und kleine Gruppen statt Masse." },
  { t: "Verlässlichkeit", d: "Feste Zeiten, fester Trainer, klare Absprachen." },
  { t: "Gemeinschaft", d: "Training, Camps und Vereinsleben gehören zusammen." },
  { t: "Leidenschaft", d: "Begeisterung für den Sport ist der Grund, wiederzukommen." },
  { t: "Persönliche Betreuung", d: "Jede:r wird einzeln gesehen, nicht als Gruppenmitglied." },
];
---

<Base title={title} description={description}>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow">Die Academy</span>
      <h1>Gemeinschaft, Leidenschaft und sportlicher Erfolg gehören zusammen.</h1>
      <p class="lead">
        Im Juni 2022 haben wir unsere Tennisschule gegründet und das Trainerteam nach und
        nach vergrößert. Heute sind wir {coachCount} Trainerinnen und Trainer an drei
        Vereinen, mit einem Anspruch, der sich nicht verändert hat.
      </p>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap">
      <div class="two">
        <div>
          <span class="eyebrow">Warum wir das machen</span>
          <h2>Menschen für Tennis begeistern und in Bewegung halten.</h2>
        </div>
        <div>
          <p>
            Wir wollen ein Umfeld schaffen, in dem sich Freizeitspieler und ambitionierte
            Spieler gleichermaßen weiterentwickeln können, sportlich und persönlich. Ob
            Anfängerin, Fortgeschrittener oder Turnierspieler: Unser Ziel ist es, dich auf
            deinem Weg zu begleiten.
          </p>
          <p>
            Dabei setzen wir auf persönliche und nachhaltige Förderung, zugeschnitten auf
            deine Stärken, deine Ziele und deine Leidenschaft. Unsere Trainerinnen und
            Trainer sind nicht nur Fachleute, sondern deine größten Unterstützer.
          </p>
        </div>
      </div>

      <ul class="values grid grid--4">
        {
          values.map((v) => (
            <li class="value">
              <h3>{v.t}</h3>
              <p>{v.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Head Coaches</span>
        <h2>Die drei Gründer.</h2>
        <p class="lead">
          Jan, Max und Timo haben die Academy 2022 gegründet. Alle drei sind DTB-B-Trainer
          und alle drei stehen weiterhin selbst auf dem Platz.
        </p>
      </div>

      <figure class="team-band">
        <img
          data-reveal
          src="/img/team-band.webp"
          alt="Jan Gerring, Max Gumz und Timo Günthner auf dem Tennisplatz"
          width="1400"
          height="600"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="grid grid--3 heads">
        {
          headCoaches.map((c) => (
            <figure class="person">
              <img
                data-reveal
                src={`/img/${c.img}.webp`}
                alt={`${c.name}, ${c.role} der Vision Tennis Academy`}
                width="640"
                height="640"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="person__name">{c.name}</span>
                <span class="person__role">
                  {c.role} · {c.license}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="two">
        <div>
          <span class="eyebrow">Wohin wir wollen</span>
          <h2>Von der Tennisschule zur Racketsport-Academy.</h2>
        </div>
        <div>
          <p>
            Wir wollen die erfolgreichste Racketsport-Academy der Region werden: mit
            hochwertigem Training, starken Trainerinnen und Trainern und einer
            Organisation, auf die man sich verlassen kann.
          </p>
          <p>
            Langfristig könnten neben Tennis auch <strong>Padel und Pickleball</strong>
            Teil unseres Angebots werden, dazu weitere Standorte und Partnervereine. Eine
            schöne Vorstellung für die Zukunft, aktuell aber ohne konkreten Zeitplan.
            Sobald sich daran etwas ändert, steht es hier.
          </p>
          <Cta />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .two p {
    max-width: 60ch;
  }
  @media (max-width: 55rem) {
    .two {
      grid-template-columns: 1fr;
    }
  }

  .values {
    list-style: none;
    margin-bottom: 0;
  }
  /* Werte als eigenständige Kacheln statt geliehener Painpoint-Optik (schwarzer
     Balken wirkt wie ein Problem, nicht wie eine Stärke) — gelber Akzent oben,
     im selben Stil wie Zitate und die Preistabelle auf /training/. */
  .value {
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--brand);
    border-radius: var(--radius);
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
  }
  .value h3 {
    font-size: var(--step-0);
    margin-bottom: 0.35rem;
  }
  .value p {
    color: var(--ink-2);
    margin: 0;
    font-size: 0.95rem;
  }

  .heads {
    max-width: 60rem;
    margin-inline: auto;
  }

  .team-band {
    margin: 0 0 clamp(1.75rem, 4vw, 2.75rem);
  }
  .team-band img {
    width: 100%;
    aspect-ratio: 7 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>

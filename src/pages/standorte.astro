---
/**
 * Consideration. Nähe ist laut Customer Journey ein Hauptkriterium der
 * Anbieterwahl — deshalb bekommt jeder Verein eine vollständige Karte mit Anlage,
 * Adresse, Beitrag und Buchungslink statt nur eines Namens.
 */
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { clubs } from "../data/site";
import { clubsLd } from "../data/jsonld";

const title = "Standorte — Vision Tennis Academy";
const description =
  "Wir trainieren am TC Bayer Dormagen, am TC Ford Köln und beim Uedesheimer TV. Anlagen, Adressen, Mitgliedsbeiträge und Buchung im Überblick.";
---

<Base title={title} description={description} jsonLd={clubsLd}>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow">Standorte</span>
      <h1>Drei Vereine zwischen Düsseldorf und Köln.</h1>
      <p class="lead">
        An allen drei Anlagen trainiert dasselbe Team nach demselben Konzept. Unterschiede
        gibt es bei der Ausstattung, der Saison und dem Mitgliedsbeitrag des Vereins.
      </p>
      <div class="cta-row"><Cta withNote /></div>
    </div>
  </section>

  {
    clubs.map((c, i) => (
      <section
        class:list={["section", i % 2 === 1 && "section--muted"]}
        id={c.slug}
      >
        <div class="wrap club">
          <div>
            <span class="eyebrow">Standort {i + 1} von {clubs.length}</span>
            <h2>{c.name}</h2>
            <address>
              {c.street}<br />
              {c.zip} {c.city}
            </address>
            <p>{c.courts}.</p>
            <p><strong>Saison:</strong> {c.season}.</p>
            <div class="cta-row">
              <a class="btn-ghost" href={c.booking} rel="noopener">
                Termine im Buchungssystem
              </a>
              <a class="btn-ghost" href={c.clubSite} rel="noopener">
                Website des Vereins
              </a>
            </div>
          </div>

          <div class="club__facts">
            <h3>Mitgliedsbeitrag des Vereins</h3>
            <dl>
              <div>
                <dt>Erwachsene</dt>
                <dd>{c.memberAdult} € / Jahr</dd>
              </div>
              <div>
                <dt>Jugendliche</dt>
                <dd>{c.memberYouth} € / Jahr</dd>
              </div>
            </dl>
            <p class="muted">
              Der Beitrag wird vom Verein erhoben, nicht von uns, und ist für regelmäßiges
              Training nötig. Für die kostenlose Probestunde brauchst du keine
              Mitgliedschaft.
            </p>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Noch unsicher?</span>
        <h2>Welcher Standort passt, klären wir vorher.</h2>
        <p class="lead">
          Schreib uns, wo ihr wohnt und wann ihr Zeit habt. Wir sagen dir, an welcher
          Anlage gerade eine passende Gruppe läuft — und legen die Probestunde dort hin.
        </p>
      </div>
      <Cta withNote />
    </div>
  </section>
</Base>

<style>
  .club {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .club address {
    font-style: normal;
    font-size: var(--step-1);
    line-height: 1.4;
    margin: 1rem 0 1.25rem;
  }

  .club p {
    max-width: 55ch;
  }

  .club__facts {
    border: 1px solid var(--line);
    border-top: 4px solid var(--brand);
    border-radius: var(--radius);
    background: var(--paper);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .club__facts h3 {
    font-size: var(--step-0);
    margin-bottom: 1rem;
  }
  .club__facts dl {
    margin: 0 0 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .club__facts dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.6rem;
  }
  .club__facts dt {
    color: var(--ink-3);
  }
  .club__facts dd {
    margin: 0;
    font-weight: 800;
  }
  .club__facts p {
    margin-bottom: 0;
  }

  @media (max-width: 55rem) {
    .club {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/**
 * Probestunden-Anfrage — der Buchungskalender der Seite.
 *
 * Bewusst ohne Backend: Vision bucht keine Einzeltermine, sondern feste
 * Wochenslots über eine ganze Saison; die verbindliche Buchung samt Abrechnung
 * läuft weiterhin über Sportision. Was hier fehlte, war der Schritt davor —
 * die kostenlose Probestunde. Genau dort springen Interessenten laut Journey ab.
 *
 * Das Wochenraster entspricht in der Form dem WeeklyCalendar aus dem
 * Little-Health-Studio-Buchungssystem (Zeilen = Stunden, Spalten = Wochentage),
 * lädt aber keine Verfügbarkeiten, sondern sammelt Wunschzeiten. Aus der Auswahl
 * entsteht eine fertige Nachricht für WhatsApp oder E-Mail.
 *
 * Datenschutz: Es verlässt nichts den Browser. Erst der Klick auf „Anfrage
 * senden" öffnet den Messenger bzw. das Mailprogramm des Nutzers mit dem
 * vorbereiteten Text. Keine Übertragung an uns, kein Server, keine Cookies.
 */
import Base from "../layouts/Base.astro";
import { clubs, site } from "../data/site";

const title = "Probestunde anfragen — Vision Tennis Academy";
const description =
  "Verein, Spielstärke und Wunschzeiten auswählen — wir suchen die passende Gruppe und melden uns zurück. Die erste Trainingsstunde ist kostenlos.";

/** Zeitraster: nachmittags und abends, dort liegt der Trainingsbetrieb. */
const slots = [
  ["14", "14–15 Uhr"],
  ["15", "15–16 Uhr"],
  ["16", "16–17 Uhr"],
  ["17", "17–18 Uhr"],
  ["18", "18–19 Uhr"],
  ["19", "19–20 Uhr"],
  ["20", "20–21 Uhr"],
];

const days = [
  ["Mo", "Montag"],
  ["Di", "Dienstag"],
  ["Mi", "Mittwoch"],
  ["Do", "Donnerstag"],
  ["Fr", "Freitag"],
  ["Sa", "Samstag"],
];

const ages = [
  "Kind, 5–9 Jahre",
  "Kind, 10–13 Jahre",
  "Jugendliche:r, 14–18 Jahre",
  "Erwachsene:r",
];

const levels = [
  "Anfänger:in — noch nie gespielt",
  "Grundlagen vorhanden",
  "Spielt regelmäßig",
  "Mannschaft oder Turnier",
];
---

<Base title={title} description={description}>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow">Kostenlose Probestunde</span>
      <h1>Sag uns, wann es passt.</h1>
      <p class="lead">
        Eine ganze Trainingsstunde zum Ausprobieren — kostenlos und ohne
        Mitgliedschaft. Wähl aus, wo und wann es euch passt; wir suchen die
        passende Gruppe und melden uns zurück.
      </p>
    </div>
  </section>

  <section class="section section--tight booking">
    <div class="wrap">
      <div id="pf">
        <!-- Schritt 1 -->
        <fieldset class="step-block">
          <legend><span class="step-n">1</span> An welchem Verein?</legend>
          <div class="choices choices--club">
            {
              clubs.map((c, i) => (
                <label class="choice">
                  <input type="radio" name="club" value={c.name} checked={i === 0} />
                  <span class="choice__body choice__body--club">
                    <span>
                      <span class="choice__t">{c.name}</span>
                      <span class="choice__s">
                        {c.zip} {c.city}
                      </span>
                    </span>
                    <img
                      src={`/img/${c.logo}.webp`}
                      alt=""
                      aria-hidden="true"
                      width="320"
                      height="320"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Schritt 2 -->
        <fieldset class="step-block">
          <legend><span class="step-n">2</span> Wer möchte trainieren?</legend>
          <div class="two-col">
            <div>
              <p class="sub-label" id="lbl-age">Alter</p>
              <div class="choices" role="group" aria-labelledby="lbl-age">
                {
                  ages.map((a, i) => (
                    <label class="choice choice--sm">
                      <input type="radio" name="age" value={a} checked={i === 0} />
                      <span class="choice__body">
                        <span class="choice__t">{a}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div>
              <p class="sub-label" id="lbl-level">Spielstärke</p>
              <div class="choices" role="group" aria-labelledby="lbl-level">
                {
                  levels.map((l, i) => (
                    <label class="choice choice--sm">
                      <input type="radio" name="level" value={l} checked={i === 0} />
                      <span class="choice__body">
                        <span class="choice__t">{l}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>
        </fieldset>

        <!-- Schritt 3 — das Wochenraster -->
        <fieldset class="step-block">
          <legend><span class="step-n">3</span> Wann passt es euch?</legend>
          <p class="hint">
            Tipp alle Zeiten an, die grundsätzlich gehen — je mehr, desto eher
            finden wir eine passende Gruppe. Mehrfachauswahl ist gewollt.
          </p>

          <div class="grid-scroll">
            <table class="week" id="week">
              <caption class="sr-only">
                Wochenraster: Wunschzeiten für die Probestunde auswählen
              </caption>
              <thead>
                <tr>
                  <th scope="col"><span class="sr-only">Uhrzeit</span></th>
                  {
                    days.map(([sh, long]) => (
                      <th scope="col">
                        <abbr title={long}>{sh}</abbr>
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  slots.map(([h, label]) => (
                    <tr>
                      <th scope="row">{label}</th>
                      {
                        days.map(([sh, long]) => (
                          <td>
                            <button
                              type="button"
                              class="cell"
                              aria-pressed="false"
                              data-day={sh}
                              data-hour={h}
                              aria-label={`${long}, ${label}`}
                            />
                          </td>
                        ))
                      }
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <label class="check">
            <input type="checkbox" name="flexible" />
            <span>Wir sind zeitlich flexibel — schlagt uns gern etwas vor.</span>
          </label>

          <p class="sub-label" style="margin-top:1.5rem">Optional</p>
          <div class="two-col">
            <label class="field">
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" placeholder="z. B. Familie Meyer" />
            </label>
            <label class="field">
              <span>Noch etwas, das wir wissen sollten?</span>
              <input type="text" name="note" placeholder="z. B. Geschwisterkind spielt schon" />
            </label>
          </div>
        </fieldset>

        <!-- Ergebnis -->
        <div class="result" id="result">
          <div>
            <p class="sub-label">Das schicken wir los</p>
            <pre id="preview" aria-live="polite"></pre>
          </div>
          <div class="send">
            <a class="btn" id="wa" href={site.whatsapp} rel="noopener">
              Anfrage per WhatsApp
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a class="btn-ghost" id="mail" href={`mailto:${site.email}`}>oder per E-Mail senden</a>
            <p class="privacy">
              Deine Angaben bleiben bis zum Klick in deinem Browser. Erst dann
              öffnet sich WhatsApp bzw. dein Mailprogramm mit dem vorbereiteten
              Text — wir empfangen vorher nichts.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Was danach passiert</span>
        <h2>Drei Schritte, dann steht ihr auf dem Platz.</h2>
      </div>
      <div class="grid grid--3">
        <div>
          <h3>Wir melden uns</h3>
          <p>Meist noch am selben Tag. Während des Trainings kann es etwas länger dauern.</p>
        </div>
        <div>
          <h3>Termin steht</h3>
          <p>Wir legen die Probestunde in eine Gruppe, die zu Alter und Niveau passt.</p>
        </div>
        <div>
          <h3>Ausprobieren</h3>
          <p>60 Minuten, kostenlos, ohne Mitgliedschaft. Schläger stellen wir, falls nötig.</p>
        </div>
      </div>
      <p class="muted" style="margin-top:2rem">
        Lieber direkt selbst buchen? Die regulären Termine der Vereine findest du
        unter <a href="/training/">Training</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .booking form {
    max-width: 58rem;
  }

  fieldset.step-block {
    border: 0;
    padding: 0;
    margin: 0 0 clamp(2.25rem, 5vw, 3.5rem);
  }

  legend {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--step-2);
    font-weight: 800;
    padding: 0;
    margin-bottom: 1.25rem;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    background: var(--brand);
    border: 2px solid var(--ink);
    border-radius: 50%;
    font-size: 0.95rem;
  }

  .hint {
    color: var(--ink-2);
    max-width: 58ch;
    margin-bottom: 1.25rem;
  }

  .sub-label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem 2rem;
  }

  /* ---- Auswahlkacheln ---- */

  .choices {
    display: grid;
    gap: 0.6rem;
  }
  .choices--club {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .choice {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .choice input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .choice__body {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    padding: 0.85rem 1rem;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .choice--sm .choice__body {
    padding: 0.6rem 0.85rem;
  }
  /* Vereinsauswahl: Name und Ort links, Wappen rechts als Ankerpunkt. Das
     Wappen ist rein dekorativ (alt=""), der Vereinsname steht daneben im Text.
     Die weiße Platte darunter ist Absicht — sie hält die Wappen auch auf der
     gelben Auswahlfläche lesbar. */
  .choice__body--club {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .choice__body--club img {
    width: clamp(3.4rem, 6vw, 4.2rem);
    height: clamp(3.4rem, 6vw, 4.2rem);
    flex: none;
    object-fit: contain;
    border-radius: 4px;
    background: #fff;
    padding: 0.3rem;
    box-shadow: 0 0 0 1px rgba(20, 20, 20, 0.12);
  }
  .choice__t {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .choice__s {
    display: block;
    font-size: var(--step--1);
    /* --ink-3 reicht auf der gelben Auswahlflaeche nicht fuer 4.5:1. */
    color: var(--ink-2);
    margin-top: 0.15rem;
  }
  .choice:hover .choice__body {
    border-color: var(--ink);
  }
  .choice input:checked + .choice__body {
    border-color: var(--ink);
    background: var(--brand);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .choice input:focus-visible + .choice__body {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  /* ---- Wochenraster ---- */

  .grid-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
  }
  table.week {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }
  .week th {
    background: var(--paper-2);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .week thead th abbr {
    text-decoration: none;
  }
  .week tbody th {
    background: var(--paper);
    text-align: right;
    white-space: nowrap;
    font-weight: 600;
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: 0;
    padding-right: 0.85rem;
    border-right: 1px solid var(--line);
  }
  .week td {
    padding: 0;
    border: 1px solid var(--line);
    border-top: 0;
    border-left: 0;
  }
  .cell {
    display: block;
    width: 100%;
    min-width: 3.4rem;
    height: 2.9rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
    transition: background 0.1s ease;
  }
  .cell:hover {
    background: var(--paper-2);
  }
  .cell[aria-pressed="true"] {
    background: var(--brand);
  }
  .cell[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 0.4rem;
    margin: -0.28rem 0 0 -0.38rem;
    border-left: 2.5px solid var(--ink);
    border-bottom: 2.5px solid var(--ink);
    transform: rotate(-45deg);
  }
  .cell:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-top: 1.1rem;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .check input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.2rem;
    accent-color: var(--brand-deep);
    flex: none;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field span {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .field input {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .field input:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    border-color: var(--ink);
  }

  /* ---- Ergebnis ---- */

  .result {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    border-top: 3px solid var(--ink);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }
  #preview {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin: 0;
    color: var(--ink-2);
  }
  .send {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .privacy {
    font-size: var(--step--1);
    color: var(--ink-3);
    margin: 0;
  }

  @media (max-width: 48rem) {
    .result {
      grid-template-columns: 1fr;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Wunschzeiten-Picker. Kein Netzwerkverkehr: Die Auswahl wird ausschließlich
  // im Browser zu einem Nachrichtentext zusammengesetzt und in die href-Werte
  // der beiden Sende-Links geschrieben.
  const form = document.getElementById("pf");
  const preview = document.getElementById("preview");
  const wa = document.getElementById("wa") as HTMLAnchorElement | null;
  const mail = document.getElementById("mail") as HTMLAnchorElement | null;

  if (form && preview && wa && mail) {
    const WA_BASE = "https://wa.me/4915129409005";
    const MAIL_TO = "info@vision-tennis.de";
    const DAY_ORDER = ["Mo", "Di", "Mi", "Do", "Fr", "Sa"];

    const cells = Array.from(
      form.querySelectorAll<HTMLButtonElement>(".cell"),
    );

    /** Gewählte Zellen nach Wochentag gruppieren und zu Zeitspannen zusammenfassen. */
    function selectedTimes(): string[] {
      const byDay = new Map<string, number[]>();
      for (const c of cells) {
        if (c.getAttribute("aria-pressed") !== "true") continue;
        const d = c.dataset.day!;
        const h = Number(c.dataset.hour);
        byDay.set(d, [...(byDay.get(d) ?? []), h]);
      }
      const out: string[] = [];
      for (const day of DAY_ORDER) {
        const hours = byDay.get(day);
        if (!hours) continue;
        hours.sort((a, b) => a - b);
        // Zusammenhängende Stunden zu einer Spanne verdichten:
        // 16,17,18 → „16–19 Uhr" statt drei Einzelangaben.
        const spans: string[] = [];
        let start = hours[0];
        let prev = hours[0];
        for (const h of hours.slice(1)) {
          if (h === prev + 1) {
            prev = h;
            continue;
          }
          spans.push(`${start}–${prev + 1} Uhr`);
          start = h;
          prev = h;
        }
        spans.push(`${start}–${prev + 1} Uhr`);
        out.push(`${day} ${spans.join(", ")}`);
      }
      return out;
    }

    function value(name: string): string {
      const checked = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      if (checked) return checked.value;
      const text = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:not([type="radio"]):not([type="checkbox"])`,
      );
      return text?.value ?? "";
    }

    function checked(name: string): boolean {
      return !!form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
    }

    function buildMessage(): string {
      const lines = [
        "Hallo Vision Tennis Academy,",
        "",
        "ich möchte gern eine kostenlose Probestunde vereinbaren.",
        "",
        `Verein: ${value("club")}`,
        `Alter: ${value("age")}`,
        `Spielstärke: ${value("level")}`,
      ];

      const times = selectedTimes();
      const flexible = checked("flexible");

      if (times.length) lines.push(`Passende Zeiten: ${times.join(" · ")}`);
      if (flexible) lines.push("Wir sind zeitlich flexibel.");
      if (!times.length && !flexible)
        lines.push("Passende Zeiten: sage ich euch gern durch.");

      const note = value("note").trim();
      if (note) lines.push(`Hinweis: ${note}`);

      const name = value("name").trim();
      lines.push("", "Viele Grüße" + (name ? `\n${name}` : ""));

      return lines.join("\n");
    }

    function update() {
      const msg = buildMessage();
      preview!.textContent = msg;
      wa!.href = `${WA_BASE}?text=${encodeURIComponent(msg)}`;
      mail!.href =
        `mailto:${MAIL_TO}` +
        `?subject=${encodeURIComponent("Anfrage kostenlose Probestunde")}` +
        `&body=${encodeURIComponent(msg)}`;
    }

    for (const c of cells) {
      c.addEventListener("click", () => {
        const on = c.getAttribute("aria-pressed") === "true";
        c.setAttribute("aria-pressed", on ? "false" : "true");
        update();
      });
    }

    form.addEventListener("input", update);
    update();
  }
</script>

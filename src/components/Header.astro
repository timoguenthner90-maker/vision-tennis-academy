---
// Story-Elemente #1 (Logo) und #2 (Navigation, 6 Punkte — Framework erlaubt 3–7).
// Ohne JavaScript: Auf schmalen Viewports bricht die Navigation in eine
// scrollbare Leiste unter dem Logo um, statt hinter einem Burger-Menü zu
// verschwinden. Ein Menü, das ohne JS aufklappt, wäre ein <details>-Konstrukt —
// bei sechs kurzen Punkten ist die sichtbare Leiste die bessere Lösung.
import { nav, site } from "../data/site";
import Cta from "./Cta.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Vision Tennis Academy — zur Startseite">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__end">
      <!-- Wie auf der Bestandsseite: Social-Profile im Kopf. Icons als Inline-SVG,
           damit kein externes Icon-Paket geladen wird. -->
      <ul class="social-links">
        <li>
          <a href={site.instagram} rel="noopener me" aria-label="Vision Tennis Academy bei Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a href={site.facebook} rel="noopener me" aria-label="Vision Tennis Academy bei Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1Z" />
            </svg>
          </a>
        </li>
      </ul>

      <div class="site-header__cta">
        <Cta size="sm" />
      </div>
    </div>
  </div>
</header>

<style>
  /* Sticky: Die Leiste bleibt beim Scrollen oben stehen — inklusive CTA, der
     damit auf jeder Bildschirmhöhe erreichbar ist. Beim Verlassen des
     Seitenkopfs verdichtet sie sich (Klasse .is-stuck kommt aus Base.astro). */
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 20;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  :global(.is-stuck) .site-header {
    box-shadow: 0 6px 24px rgba(20, 20, 20, 0.09);
    border-bottom-color: transparent;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.1rem;
    transition: padding-block 0.2s ease;
  }

  :global(.is-stuck) .site-header__inner {
    padding-block: 0.55rem;
  }

  .site-header__brand {
    display: block;
    text-decoration: none;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    list-style: none;
    justify-content: center;
  }

  .site-nav a {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .site-nav a:hover {
    border-bottom-color: var(--ink);
  }

  .site-nav a[aria-current="page"] {
    border-bottom-color: var(--brand);
  }

  @media (max-width: 60rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
    .site-nav {
      grid-column: 1 / -1;
      order: 3;
      border-top: 1px solid var(--line);
      padding-top: 0.6rem;
    }
    /* Umbruch statt horizontalem Scrollen: Eine abgeschnittene Scrollleiste liest
       sich wie ein Fehler, sechs kurze Punkte passen umgebrochen in zwei Zeilen. */
    .site-nav ul {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
  }
  .social-links a {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    color: var(--ink-2);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .social-links a:hover {
    background: var(--brand);
    color: var(--ink);
  }

  /* Ab hier wird es im Kopf eng. Die Profile stehen weiterhin im Footer und
     auf der Kontaktseite, gehen hier also nicht verloren. */
  @media (max-width: 46rem) {
    .social-links {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .site-header__cta {
      display: none;
    }
  }
</style>

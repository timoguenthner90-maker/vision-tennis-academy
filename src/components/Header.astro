---
// Story-Elemente #1 (Logo) und #2 (Navigation, 6 Punkte — Framework erlaubt 3–7).
// Ohne JavaScript: Auf schmalen Viewports bricht die Navigation in eine
// scrollbare Leiste unter dem Logo um, statt hinter einem Burger-Menü zu
// verschwinden. Ein Menü, das ohne JS aufklappt, wäre ein <details>-Konstrukt —
// bei sechs kurzen Punkten ist die sichtbare Leiste die bessere Lösung.
import { nav } from "../data/site";
import Cta from "./Cta.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Vision Tennis Academy — zur Startseite">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__cta">
      <Cta size="sm" />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: relative;
    z-index: 10;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 0.9rem;
  }

  .site-header__brand {
    display: block;
    text-decoration: none;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    list-style: none;
    justify-content: center;
  }

  .site-nav a {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .site-nav a:hover {
    border-bottom-color: var(--ink);
  }

  .site-nav a[aria-current="page"] {
    border-bottom-color: var(--brand);
  }

  @media (max-width: 60rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
    .site-nav {
      grid-column: 1 / -1;
      order: 3;
      border-top: 1px solid var(--line);
      padding-top: 0.6rem;
    }
    /* Umbruch statt horizontalem Scrollen: Eine abgeschnittene Scrollleiste liest
       sich wie ein Fehler, sechs kurze Punkte passen umgebrochen in zwei Zeilen. */
    .site-nav ul {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }
  }

  @media (max-width: 26rem) {
    .site-header__cta {
      display: none;
    }
  }
</style>

---
// Story-Element #1. Das Original-Wortmarken-Logo des Kunden (Auge mit Tennisball)
// liegt als PNG mit Transparenz vor und wird lokal ausgeliefert — kein Hotlink
// auf die Shopify-CDN.
---

<img
  src="/img/logo.png"
  alt="Vision Tennis Academy"
  width="480"
  height="398"
  class="logo"
/>

<style>
  .logo {
    width: auto;
    height: clamp(3.4rem, 6.5vw, 4.6rem);
    transition: height 0.2s ease;
  }

  /* Beim Scrollen schrumpft der Header — das Logo geht mit, damit die Leiste
     schmal bleibt und trotzdem präsent wirkt. */
  :global(.is-stuck) .logo {
    height: clamp(2.6rem, 4.5vw, 3.2rem);
  }
</style>

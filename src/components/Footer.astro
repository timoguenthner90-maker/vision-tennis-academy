---
// Story-Element #12 (Footer). Jobs, Impressum und Datenschutz sitzen hier statt in
// der Hauptnavigation — das Framework begrenzt die Navigation auf 3–7 Punkte.
import { site, nav, clubs } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__mark">Vision Tennis Academy</p>
        <p class="site-footer__claim">
          Die moderne Racketsport-Academy zwischen Düsseldorf und Köln.
          Tennistraining für Kinder, Jugendliche und Erwachsene an drei Vereinen.
        </p>
        <ul class="site-footer__social">
          <li><a href={site.instagram} rel="noopener">Instagram</a></li>
          <li><a href={site.facebook} rel="noopener">Facebook</a></li>
        </ul>
      </div>

      <div>
        <h2>Seiten</h2>
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/jobs/">Jobs</a></li>
        </ul>
      </div>

      <div>
        <h2>Standorte</h2>
        <ul>
          {clubs.map((c) => <li><a href={`/standorte/#${c.slug}`}>{c.name}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Kontakt</h2>
        <ul>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.whatsapp} rel="noopener">WhatsApp</a></li>
        </ul>
        <address>
          {site.legalName}<br />
          {site.street}<br />
          {site.zip} {site.city}
        </address>
      </div>
    </div>

    <div class="site-footer__base">
      <p>© {year} {site.legalName}</p>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #d5d5d0;
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    font-size: 0.95rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 2.5rem;
  }

  .site-footer__grid > div:first-child {
    grid-column: span 1;
    min-width: min(100%, 20rem);
  }

  .site-footer__mark {
    color: var(--paper);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .site-footer__claim {
    max-width: 34ch;
    color: #a6a6a1;
  }

  h2 {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.9rem;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  a:hover {
    border-bottom-color: var(--brand);
  }

  .site-footer__social {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.1rem;
  }

  address {
    font-style: normal;
    margin-top: 1.1rem;
    color: #a6a6a1;
    line-height: 1.55;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #333330;
    color: #86867f;
    font-size: 0.85rem;
  }
  .site-footer__base p {
    margin: 0;
  }
  .site-footer__base ul {
    display: flex;
    gap: 1.5rem;
  }
</style>
